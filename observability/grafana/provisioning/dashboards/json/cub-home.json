    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 9 },
      "id": 7,
      "title": "Throughput API (req/s)",
      "description": "Tasa de peticiones HTTP al inventory-api. Debe subir al navegar la app.",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{job=\"inventory-api\"}[1m]))", "legendFormat": "req/s" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 } },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 9 },
      "id": 8,
      "title": "Latencia p95",
      "description": "Percentil 95 de latencia HTTP. Alerta HighLatencyP95 si supera 1s sostenido.",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"inventory-api\"}[5m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 16 },
      "id": 9,
      "title": "Logs recientes del backend (con contexto)",
      "description": "Logs del contenedor backend. Tras login deben aparecer user= y endpoint= en el filtro de Security.",
      "type": "logs",
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true },
      "targets": [
        { "expr": "{service_name=\"backend\"} or {container=~\".*backend.*\"}", "refId": "A" }
      ]
    }
