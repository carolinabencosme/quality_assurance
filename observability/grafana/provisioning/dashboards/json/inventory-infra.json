{
  "annotations": { "list": [] },
  "description": "Infraestructura JVM/proceso/DB pool del inventory-api. Cumple metricas PDF: CPU, memoria, JVM, database pool.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "Home Cub", "type": "link", "url": "/d/cub-home", "icon": "home" },
    { "title": "API", "type": "link", "url": "/d/inventory-api-overview", "icon": "dashboard" }
  ],
  "panels": [
    {
      "type": "text",
      "title": "Que mirar aqui",
      "id": 100,
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "**Infra** — Salud del proceso Java y del pool **HikariCP**. Explica al profesor: heap/threads/CPU son metricas de infraestructura; idle/active/pending/max/timeouts demuestran monitoreo del pool de BD. Alerta `HighCpuUsage` / `HighJvmMemoryUsage` en Prometheus → Alertmanager."
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "id": 1,
      "title": "JVM memory used (heap / nonheap)",
      "description": "Memoria usada por area JVM.",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{job=\"inventory-api\"}) by (area)", "legendFormat": "{{area}}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "id": 2,
      "title": "JVM threads",
      "type": "timeseries",
      "targets": [
        { "expr": "jvm_threads_live_threads{job=\"inventory-api\"}", "legendFormat": "live" },
        { "expr": "jvm_threads_daemon_threads{job=\"inventory-api\"}", "legendFormat": "daemon" },
        { "expr": "jvm_threads_peak_threads{job=\"inventory-api\"}", "legendFormat": "peak" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.85 }] }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 11 },
      "id": 3,
      "title": "CPU process / system",
      "description": "Alerta HighCpuUsage si process > 85% o system > 90% por 5m.",
      "type": "timeseries",
      "targets": [
        { "expr": "process_cpu_usage{job=\"inventory-api\"}", "legendFormat": "process" },
        { "expr": "system_cpu_usage{job=\"inventory-api\"}", "legendFormat": "system" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 11 },
      "id": 4,
      "title": "Hikari active / idle / pending",
      "description": "Pool JDBC: active en uso, idle libres, pending en cola.",
      "type": "timeseries",
      "targets": [
        { "expr": "hikaricp_connections_active{job=\"inventory-api\"}", "legendFormat": "active" },
        { "expr": "hikaricp_connections_idle{job=\"inventory-api\"}", "legendFormat": "idle" },
        { "expr": "hikaricp_connections_pending{job=\"inventory-api\"}", "legendFormat": "pending" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 11 },
      "id": 5,
      "title": "Process uptime",
      "type": "stat",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [
        { "expr": "process_uptime_seconds{job=\"inventory-api\"}", "legendFormat": "uptime" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 19 },
      "id": 8,
      "title": "Hikari max connections",
      "type": "stat",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        { "expr": "hikaricp_connections_max{job=\"inventory-api\"}", "legendFormat": "max" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 19 },
      "id": 6,
      "title": "Hikari idle (detalle)",
      "type": "timeseries",
      "targets": [
        { "expr": "hikaricp_connections_idle{job=\"inventory-api\"}", "legendFormat": "idle" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 19 },
      "id": 9,
      "title": "Hikari timeouts (5m increase)",
      "description": "Timeouts al obtener conexion del pool. Debe permanecer en 0 en demo normal.",
      "type": "timeseries",
      "targets": [
        { "expr": "increase(hikaricp_connections_timeout_total{job=\"inventory-api\"}[5m])", "legendFormat": "timeouts" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.75 }, { "color": "red", "value": 0.85 }] }
        }
      },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 26 },
      "id": 15,
      "title": "Heap usage ratio (used / max)",
      "description": "Alerta HighJvmMemoryUsage si > 85% por 5m.",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{job=\"inventory-api\",area=\"heap\"}) / clamp_min(sum(jvm_memory_max_bytes{job=\"inventory-api\",area=\"heap\"}), 1)", "legendFormat": "heap ratio" }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["inventory-qas", "infra"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Inventory Infra",
  "uid": "inventory-infra",
  "version": 2
}
