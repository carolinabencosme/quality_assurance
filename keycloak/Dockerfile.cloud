# Keycloak 26 for Render — bind $PORT + optional Postgres + realm import
FROM quay.io/keycloak/keycloak:26.0.7

USER root
COPY realm-export.json /opt/keycloak/data/import/realm-export.json
COPY themes /opt/keycloak/themes
COPY docker-entrypoint-cloud.sh /opt/keycloak/docker-entrypoint-cloud.sh
RUN chmod +x /opt/keycloak/docker-entrypoint-cloud.sh

# Volver al usuario de la imagen Keycloak
USER 1000

ENV KC_HTTP_ENABLED=true \
    KC_HEALTH_ENABLED=true \
    KC_HOSTNAME_STRICT=false \
    KC_PROXY_HEADERS=xforwarded \
    KC_BOOTSTRAP_ADMIN_USERNAME=admin \
    KC_BOOTSTRAP_ADMIN_PASSWORD=admin \
    KEYCLOAK_ADMIN=admin \
    KEYCLOAK_ADMIN_PASSWORD=admin \
    JAVA_OPTS_APPEND="-Xms64m -Xmx384m -XX:MaxMetaspaceSize=128m"

EXPOSE 8080

ENTRYPOINT ["/opt/keycloak/docker-entrypoint-cloud.sh"]
