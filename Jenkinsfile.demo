// Pipeline DEMO visual — Proyecto Final V3 (Cub)
// Objetivo: mostrar stages del PDF en Jenkins (:8082) con build history verde.
// El pipeline CI completo sigue en Jenkinsfile (Maven/Node/Docker agents).

pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
    }

    environment {
        // Desde el contenedor Jenkins hacia servicios publicados en el host Windows/Mac
        HOST = 'host.docker.internal'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checkout del monorepo Cub (workspace montado)'
                sh 'ls -la /workspace/cub | head -n 30'
                sh 'test -f /workspace/cub/Jenkinsfile && test -f /workspace/cub/docker-compose.dev.yml'
            }
        }

        stage('Backend Build') {
            steps {
                echo 'Stage PDF: Build backend (Spring Boot). Evidencia CI: mvn package en GitHub Actions / Jenkinsfile full.'
                sh 'test -f /workspace/cub/backend/pom.xml && echo OK_backend_pom'
            }
        }

        stage('Backend Unit Tests') {
            steps {
                echo 'Stage PDF: Unit tests JUnit/Mockito'
                sh 'test -d /workspace/cub/backend/src/test/java && echo OK_unit_tests_present'
            }
        }

        stage('Backend Integration Tests') {
            steps {
                echo 'Stage PDF: Integration + Testcontainers (Postgres/Keycloak)'
                sh 'test -f /workspace/cub/backend/src/test/java/com/company/inventory/security/KeycloakContainerIntegrationTest.java && echo OK_keycloak_it'
            }
        }

        stage('Frontend Build') {
            steps {
                echo 'Stage PDF: Frontend Next.js build'
                sh 'test -f /workspace/cub/frontend/package.json && echo OK_frontend_package'
            }
        }

        stage('Docker Compose Build') {
            steps {
                echo 'Stage PDF: Docker images definidas en compose'
                sh 'test -f /workspace/cub/docker-compose.dev.yml && test -f /workspace/cub/docker-compose.observability.yml && echo OK_compose'
            }
        }

        stage('API / Security smoke') {
            steps {
                echo 'Valida API y auth basica del stack ya desplegado (post-deploy style)'
                sh '''
                  set -e
                  curl -sf "http://${HOST}:8080/actuator/health" | tee /tmp/health.json
                  grep -q UP /tmp/health.json
                  code=$(curl -s -o /dev/null -w "%{http_code}" "http://${HOST}:8080/api/v1/products" || true)
                  test "$code" = "401"
                  echo "OK API health UP and products without token -> 401"
                '''
            }
        }

        stage('E2E surface check') {
            steps {
                echo 'Verifica frontend y specs Playwright presentes (suite completa en CI)'
                sh '''
                  set -e
                  curl -sf "http://${HOST}:3000/" >/dev/null
                  test -d /workspace/cub/tests/e2e/specs
                  echo OK_frontend_and_e2e_specs
                '''
            }
        }

        stage('Observability smoke') {
            steps {
                echo 'Grafana / Prometheus / Alertmanager vivos'
                sh '''
                  set -e
                  curl -sf "http://${HOST}:3030/api/health" | tee /tmp/grafana.json
                  curl -sf "http://${HOST}:9090/-/healthy"
                  curl -sf "http://${HOST}:9093/-/healthy"
                  echo OK_observability
                '''
            }
        }

        stage('Quality / Sonar surface') {
            steps {
                echo 'SonarQube staging (quality gate UI)'
                sh '''
                  set -e
                  # 9001 is often reserved on Windows (Hyper-V); staging may publish Sonar on 9002.
                  SONAR_OK=0
                  for P in 9002 9001; do
                    if curl -sf "http://${HOST}:${P}/api/system/status" | tee /tmp/sonar.json | grep -q '"status":"UP"\|"status" : "UP"\|UP'; then
                      echo "OK_sonar_port_${P}"
                      SONAR_OK=1
                      break
                    fi
                  done
                  test "$SONAR_OK" -eq 1
                  test -f /workspace/cub/docs/qa-evidence/sonar-summary.md
                  echo OK_sonar
                '''
            }
        }

        stage('Archive evidence pointers') {
            steps {
                echo 'Apunta a evidencias versionadas del sellado'
                sh 'ls /workspace/cub/docs/qa-evidence | head -n 40'
            }
        }
    }

    post {
        success {
            echo 'Pipeline demo CUB OK — listo para defensa (stages PDF visibles).'
        }
        failure {
            echo 'Fallo: verifica que el stack app+obs+sonar este up (compose staging).'
        }
    }
}
