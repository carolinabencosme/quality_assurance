FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Rewrites de next.config se evalúan en build (no en runtime del standalone).
ARG API_PROXY_TARGET=http://backend:8080
ARG KEYCLOAK_PROXY_TARGET=http://keycloak:8080
ARG NEXT_PUBLIC_API_URL=/api/v1
ARG NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8081
ARG NEXT_PUBLIC_KEYCLOAK_REALM=inventory-realm
ARG NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=inventory-frontend
ARG NEXT_PUBLIC_KEYCLOAK_API_CLIENT_ID=inventory-api
ARG NEXT_PUBLIC_APP_URL=http://localhost:3000
ENV API_PROXY_TARGET=$API_PROXY_TARGET \
    KEYCLOAK_PROXY_TARGET=$KEYCLOAK_PROXY_TARGET \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_KEYCLOAK_URL=$NEXT_PUBLIC_KEYCLOAK_URL \
    NEXT_PUBLIC_KEYCLOAK_REALM=$NEXT_PUBLIC_KEYCLOAK_REALM \
    NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=$NEXT_PUBLIC_KEYCLOAK_CLIENT_ID \
    NEXT_PUBLIC_KEYCLOAK_API_CLIENT_ID=$NEXT_PUBLIC_KEYCLOAK_API_CLIENT_ID \
    NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN addgroup -S nextjs && adduser -S nextjs -G nextjs
COPY --from=build /app/public ./public
COPY --from=build --chown=nextjs:nextjs /app/.next/standalone ./
COPY --from=build --chown=nextjs:nextjs /app/.next/static ./.next/static
USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
CMD ["node", "server.js"]
